<UserControl
    x:Class="PdfImageToolkit.Views.Image.ImageResizeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PdfImageToolkit.Core.Models"
    xmlns:vm="using:PdfImageToolkit.ViewModels.Image"
    mc:Ignorable="d">

    <ScrollViewer Padding="16,8,16,24">
        <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Resize Images" FontSize="22" FontWeight="Bold" />
                <TextBlock
                    Text="Resize photos and graphics by scaling percentage or exact dimensions with aspect ratio lock."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Drop Zone -->
            <Border
                x:Name="DropZone"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE790;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Drag and drop image files here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Supports JPG, PNG, WebP, HEIC, and BMP" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <Button
                        Content="Browse Images..."
                        Command="{x:Bind ViewModel.PickImagesCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        AutomationProperties.Name="Browse Images to Resize Button" />
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsClosable="True" />

            <!-- Images List Panel -->
            <Border
                Visibility="{x:Bind ViewModel.ImagesVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Selected Images" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button
                                Content="✕ Remove Selected"
                                Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSelectedImage, Mode=OneWay}"
                                AutomationProperties.Name="Remove Selected Image Button" />
                            <Button
                                Content="Clear All"
                                Command="{x:Bind ViewModel.ClearImagesCommand}"
                                AutomationProperties.Name="Clear All Images Button" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.Images}"
                        SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}"
                        SelectionMode="Single"
                        MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileItem">
                                <Grid Padding="8,6,8,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEB9F;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind FilePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Options Panel -->
            <Border
                Visibility="{x:Bind ViewModel.ImagesVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Resize Mode" FontWeight="SemiBold" FontSize="15" />

                    <!-- Mode Selector -->
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.ResizeModeIndex, Mode=TwoWay}">
                        <RadioButton Content="Scale by Percentage (e.g. 50%, 75%, 150%)" />
                        <RadioButton Content="Exact Dimensions / Standard Presets (Width &amp; Height)" />
                    </RadioButtons>

                    <!-- Percentage Controls -->
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.PercentageVisibility, Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="Scale Factor" FontSize="13" FontWeight="Medium" />
                            <TextBlock Text="{x:Bind ViewModel.ScalePercent, Mode=OneWay}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" />
                        </Grid>
                        <Slider
                            Minimum="10"
                            Maximum="200"
                            Value="{x:Bind ViewModel.ScalePercent, Mode=TwoWay}"
                            StepFrequency="5"
                            AutomationProperties.Name="Scale Percentage Slider" />
                        <TextBlock Text="Values below 100% shrink the image; values above 100% enlarge it." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Dimensions Controls -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.DimensionsVisibility, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Quick Preset" FontSize="13" FontWeight="Medium" />
                            <ComboBox SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}" Width="300" AutomationProperties.Name="Resize Preset ComboBox">
                                <ComboBoxItem Content="Custom Dimensions" />
                                <ComboBoxItem Content="1080 × 1080 (Square / Instagram)" />
                                <ComboBoxItem Content="1280 × 720 (HD 720p)" />
                                <ComboBoxItem Content="1920 × 1080 (Full HD 1080p)" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Target Width (px)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox
                                    Value="{x:Bind ViewModel.TargetWidth, Mode=TwoWay}"
                                    SpinButtonPlacementMode="Compact"
                                    Minimum="1"
                                    Maximum="10000"
                                    Width="160"
                                    AutomationProperties.Name="Target Width NumberBox" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Target Height (px)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox
                                    Value="{x:Bind ViewModel.TargetHeight, Mode=TwoWay}"
                                    SpinButtonPlacementMode="Compact"
                                    Minimum="1"
                                    Maximum="10000"
                                    Width="160"
                                    AutomationProperties.Name="Target Height NumberBox" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox
                            Content="Lock aspect ratio (prevents stretching and distortion)"
                            IsChecked="{x:Bind ViewModel.MaintainAspectRatio, Mode=TwoWay}"
                            AutomationProperties.Name="Maintain Aspect Ratio Checkbox" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Controls -->
            <StackPanel Visibility="{x:Bind ViewModel.ImagesVisibility, Mode=OneWay}" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        Content="Resize Images"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ExecuteResizeCommand}"
                        IsEnabled="{x:Bind ViewModel.CanResize, Mode=OneWay}"
                        Padding="24,8"
                        AutomationProperties.Name="Start Image Resize Button" />
                    <Button
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}"
                        AutomationProperties.Name="Cancel Image Resize Button" />
                </StackPanel>

                <!-- Progress Bar -->
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}">
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Results Card -->
            <Border
                Visibility="{x:Bind ViewModel.ResultVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Resize Successful!" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.OutputSummaryText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Content="Open File"
                            Command="{x:Bind ViewModel.OpenResultFileCommand}"
                            AutomationProperties.Name="Open Resized Image File" />
                        <Button
                            Content="Open Folder"
                            Command="{x:Bind ViewModel.OpenResultFolderCommand}"
                            AutomationProperties.Name="Open Resized Image Folder" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
