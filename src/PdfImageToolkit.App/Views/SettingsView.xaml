<Page
    x:Class="PdfImageToolkit.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:PdfImageToolkit.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock
                Text="Settings"
                FontSize="28"
                FontWeight="Bold"
                AutomationProperties.Name="Settings Page Title" />

            <!-- Output Folder Section -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Default Output Folder" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock
                        Text="Where processed PDF and image files will be saved by default."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="10" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay}"
                            PlaceholderText="Default: Documents\PDF &amp; Image Toolkit"
                            IsReadOnly="True"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Default Output Folder Path" />
                        <Button
                            Grid.Column="1"
                            Content="Browse..."
                            Command="{x:Bind ViewModel.ChooseOutputFolderCommand}"
                            AutomationProperties.Name="Browse Output Folder Button" />
                        <Button
                            Grid.Column="2"
                            Content="Reset"
                            Command="{x:Bind ViewModel.ResetOutputFolderCommand}"
                            AutomationProperties.Name="Reset Output Folder Button" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance Section -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock
                        Text="Choose how the application looks."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                        Width="200"
                        AutomationProperties.Name="App Theme Selection">
                        <ComboBoxItem Content="Use System Setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Metadata Preferences -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Strip EXIF &amp; Document Metadata by Default" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock
                            Text="Automatically strip camera, location, and author metadata during image and PDF conversions."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{x:Bind ViewModel.StripMetadataDefault, Mode=TwoWay}"
                        OnContent="Enabled"
                        OffContent="Disabled"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Default Strip Metadata Toggle" />
                </Grid>
            </Border>

            <!-- Debug Sim Pro Toggle (visible in Debug builds) -->
            <Border
                x:Name="DebugProCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemAccentColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Developer: Simulate Pro Unlock" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock
                            Text="Debug toggle to test unlimited operations, batching, and file sizes without making a Store purchase."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{x:Bind ViewModel.SimulatedPro, Mode=TwoWay}"
                        OnContent="Pro Active"
                        OffContent="Free Tier"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Simulate Pro Mode Toggle" />
                </Grid>
            </Border>

            <!-- Privacy & Offline Notice -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="16" />
                        <TextBlock Text="100% Offline &amp; Privacy First" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>
                    <TextBlock
                        Text="All processing is performed 100% locally on your computer. Files never leave your PC. No accounts, no analytics, no telemetry, and no network calls are ever made by the processing engines."
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.AppVersion}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
