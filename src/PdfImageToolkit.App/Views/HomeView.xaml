<Page
    x:Class="PdfImageToolkit.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="28" MaxWidth="1100" HorizontalAlignment="Left">
            <!-- Header Banner -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Pdf Image Toolkit: offline"
                    FontSize="28"
                    FontWeight="Bold"
                    AutomationProperties.Name="Page Header" />
                <TextBlock
                    Text="Fast, simple, offline tools to merge, split, compress, and convert your files locally on your PC."
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.Name="Page Subheader" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock
                        Text="100% Offline: Your files never leave your computer."
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- PDF Tools Section -->
            <StackPanel Spacing="14">
                <TextBlock
                    Text="PDF Tools"
                    FontSize="20"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="PDF Tools Header" />
                <GridView
                    x:Name="PdfToolsGrid"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="330" ItemHeight="110" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <!-- Merge PDF -->
                    <Button
                        Click="ToolCard_Click"
                        Tag="PdfTools:Merge"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="Merge PDF Tool Card">
                        <Grid Padding="16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D5;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Merge PDF" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock
                                    Text="Combine multiple PDF files into one in your chosen order."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Split PDF -->
                    <Button
                        Click="ToolCard_Click"
                        Tag="PdfTools:Split"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="Split PDF Tool Card">
                        <Grid Padding="16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B9;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Split PDF" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock
                                    Text="Extract page ranges (e.g. 1-3,5), split every page or every N pages."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Compress PDF -->
                    <Button
                        Click="ToolCard_Click"
                        Tag="PdfTools:Compress"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="Compress PDF Tool Card">
                        <Grid Padding="16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE753;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Compress PDF" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock
                                    Text="Reduce file size with Light or Strong rasterized compression."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Rotate PDF -->
                    <Button
                        Click="ToolCard_Click"
                        Tag="PdfTools:Rotate"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="Rotate PDF Tool Card">
                        <Grid Padding="16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7AD;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Rotate PDF" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock
                                    Text="Rotate all or selected pages by 90°, 180°, or 270°."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Images to PDF -->
                    <Button
                        Click="ToolCard_Click"
                        Tag="PdfTools:ImagesToPdf"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="Images to PDF Tool Card">
                        <Grid Padding="16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9F;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Images to PDF" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock
                                    Text="Turn JPG, PNG, and WebP images into a single clean PDF document."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- PDF to Images -->
                    <Button
                        Click="ToolCard_Click"
                        Tag="PdfTools:PdfToImages"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="PDF to Images Tool Card">
                        <Grid Padding="16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9D;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="PDF to Images" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock
                                    Text="Export PDF pages to high-resolution PNG or JPG image files."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </GridView>
            </StackPanel>

            <!-- Image Tools Section -->
            <StackPanel Spacing="14">
                <TextBlock
                    Text="Image Tools"
                    FontSize="20"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="Image Tools Header" />
                <GridView
                    x:Name="ImageToolsGrid"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="330" ItemHeight="110" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <!-- Compress Images -->
                    <Button
                        Click="ToolCard_Click"
                        Tag="ImageTools:Compress"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="Compress Images Tool Card">
                        <Grid Padding="16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE753;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Compress Images" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock
                                    Text="Reduce image file sizes in batch with custom quality control."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Resize Images -->
                    <Button
                        Click="ToolCard_Click"
                        Tag="ImageTools:Resize"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="Resize Images Tool Card">
                        <Grid Padding="16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE740;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Resize Images" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock
                                    Text="Resize by percent, custom dimensions with aspect lock, or presets."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Convert Images -->
                    <Button
                        Click="ToolCard_Click"
                        Tag="ImageTools:Convert"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="Convert Images Tool Card">
                        <Grid Padding="16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B1;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Convert Images" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock
                                    Text="Convert between JPG, PNG, WebP, and HEIC with EXIF stripping."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
