<UserControl
    x:Class="PdfImageToolkit.Views.Pdf.CompressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PdfImageToolkit.ViewModels.Pdf"
    mc:Ignorable="d">

    <ScrollViewer Padding="16,8,16,24">
        <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Compress PDF Document" FontSize="22" FontWeight="Bold" />
                <TextBlock
                    Text="Reduce PDF file size for easy sharing, archiving, or emailing."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Drop Zone -->
            <Border
                x:Name="DropZone"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE753;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Drag and drop a PDF file here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="or click below to choose a file" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <Button
                        Content="Browse PDF File..."
                        Command="{x:Bind ViewModel.PickFileCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        AutomationProperties.Name="Browse PDF File to Compress" />
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsClosable="True" />

            <!-- Selected File Card -->
            <Border
                Visibility="{x:Bind ViewModel.FileVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A5;" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SelectedFile.FileName, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedFile.DetailText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SelectedFile.FormattedSize, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        Grid.Column="3"
                        Content="Remove"
                        Command="{x:Bind ViewModel.ClearFileCommand}"
                        AutomationProperties.Name="Remove Selected File" />
                </Grid>
            </Border>

            <!-- Compression Options Panel -->
            <Border
                Visibility="{x:Bind ViewModel.FileVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Compression Mode" FontWeight="SemiBold" FontSize="15" />

                    <!-- Mode Selector -->
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.CompressionModeIndex, Mode=TwoWay}">
                        <RadioButton Content="Light Compression (Flate stream re-compression &amp; strip metadata; preserves 100% searchable text)" />
                        <RadioButton Content="Strong Compression (Rasterizes pages to high-efficiency JPEG; maximum size reduction)" />
                    </RadioButtons>

                    <!-- Strong Mode Settings -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.StrongModeVisibility, Mode=OneWay}" Margin="0,4,0,0">
                        <InfoBar
                            IsOpen="True"
                            Severity="Warning"
                            IsClosable="False"
                            Message="Notice: Strong mode rasterizes each page into images. Text inside the PDF will no longer be selectable or searchable." />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Rasterization Resolution (DPI)" FontSize="13" FontWeight="Medium" />
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.DpiIndex, Mode=TwoWay}" MaxColumns="3">
                                <RadioButton Content="96 DPI (Smallest size, web/screen)" />
                                <RadioButton Content="150 DPI (Balanced quality &amp; size)" />
                                <RadioButton Content="200 DPI (High readability)" />
                            </RadioButtons>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="JPEG Quality" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="{x:Bind ViewModel.JpegQuality, Mode=OneWay}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                            <Slider
                                Value="{x:Bind ViewModel.JpegQuality, Mode=TwoWay}"
                                Minimum="40"
                                Maximum="90"
                                StepFrequency="5"
                                AutomationProperties.Name="JPEG Quality Slider" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Panel -->
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.FileVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Content="Compress PDF"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ExecuteCompressCommand}"
                    IsEnabled="{x:Bind ViewModel.CanCompress, Mode=OneWay}"
                    Padding="28,10,28,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="Compress PDF Primary Action" />
                <Button
                    Grid.Column="1"
                    Content="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Padding="16,10,16,10"
                    AutomationProperties.Name="Cancel Compress Button" />
            </Grid>

            <!-- Progress Panel -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}">
                <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Result Card -->
            <Border
                Visibility="{x:Bind ViewModel.ResultVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemAccentColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Compression Finished!" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>

                    <!-- Savings -->
                    <Border
                        Background="{ThemeResource SystemAccentColorLight3}"
                        CornerRadius="6"
                        Padding="12,8,12,8"
                        HorizontalAlignment="Left">
                        <TextBlock
                            Text="{x:Bind ViewModel.SavingsSummaryText, Mode=OneWay}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasWarningMessage, Mode=OneWay}"
                        Severity="Informational"
                        IsClosable="False"
                        Message="{x:Bind ViewModel.Result.WarningMessage, Mode=OneWay}" />

                    <TextBlock Text="{x:Bind ViewModel.CompressedFilePath, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button
                            Content="Open File"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenResultFileCommand}"
                            AutomationProperties.Name="Open Compressed PDF Button" />
                        <Button
                            Content="Open Folder"
                            Command="{x:Bind ViewModel.OpenResultFolderCommand}"
                            AutomationProperties.Name="Open Output Folder Button" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
