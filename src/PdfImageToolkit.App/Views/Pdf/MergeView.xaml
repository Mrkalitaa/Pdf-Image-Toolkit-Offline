<UserControl
    x:Class="PdfImageToolkit.Views.Pdf.MergeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PdfImageToolkit.Core.Models"
    xmlns:vm="using:PdfImageToolkit.ViewModels.Pdf"
    mc:Ignorable="d">

    <ScrollViewer Padding="16,8,16,24">
        <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Merge PDF Files" FontSize="22" FontWeight="Bold" />
                <TextBlock
                    Text="Combine multiple PDF documents into a single file in the exact order you specify."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Drop Zone -->
            <Border
                x:Name="DropZone"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE8D5;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Drag and drop PDF files here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="or click below to browse from your computer" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <Button
                        Content="Browse PDF Files..."
                        Command="{x:Bind ViewModel.PickFilesCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        AutomationProperties.Name="Browse PDF Files Button" />
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsClosable="True" />

            <!-- File List Panel -->
            <Border
                Visibility="{x:Bind ViewModel.FilesVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <!-- Toolbar for Reordering and Removal -->
                    <Grid>
                        <TextBlock Text="Documents to Merge (Select an item to reorder)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button
                                Content="▲ Move Up"
                                Command="{x:Bind ViewModel.MoveSelectedUpCommand}"
                                IsEnabled="{x:Bind ViewModel.CanMoveSelectedUp, Mode=OneWay}"
                                AutomationProperties.Name="Move Selected File Up Button" />
                            <Button
                                Content="▼ Move Down"
                                Command="{x:Bind ViewModel.MoveSelectedDownCommand}"
                                IsEnabled="{x:Bind ViewModel.CanMoveSelectedDown, Mode=OneWay}"
                                AutomationProperties.Name="Move Selected File Down Button" />
                            <Button
                                Content="✕ Remove"
                                Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}"
                                AutomationProperties.Name="Remove Selected File Button" />
                            <Button
                                Content="Clear All"
                                Command="{x:Bind ViewModel.ClearFilesCommand}"
                                AutomationProperties.Name="Clear All Files Button" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.Files}"
                        SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                        SelectionMode="Single"
                        CanReorderItems="True"
                        AllowDrop="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileItem">
                                <Grid Padding="8,8,8,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Action Panel -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Content="Merge PDFs"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ExecuteMergeCommand}"
                    IsEnabled="{x:Bind ViewModel.CanMerge, Mode=OneWay}"
                    Padding="28,10,28,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="Merge PDFs Primary Action" />
                <Button
                    Grid.Column="1"
                    Content="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Padding="16,10,16,10"
                    AutomationProperties.Name="Cancel Merge Button" />
            </Grid>

            <!-- Progress Panel -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}">
                <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Result Card -->
            <Border
                Visibility="{x:Bind ViewModel.ResultVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemAccentColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Merge Completed Successfully!" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.MergedFilePath, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button
                            Content="Open File"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenResultFileCommand}"
                            AutomationProperties.Name="Open Merged File Button" />
                        <Button
                            Content="Open Folder"
                            Command="{x:Bind ViewModel.OpenResultFolderCommand}"
                            AutomationProperties.Name="Open Output Folder Button" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
