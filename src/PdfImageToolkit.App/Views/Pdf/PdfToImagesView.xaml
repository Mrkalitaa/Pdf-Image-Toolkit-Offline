<UserControl
    x:Class="PdfImageToolkit.Views.Pdf.PdfToImagesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PdfImageToolkit.ViewModels.Pdf"
    mc:Ignorable="d">

    <ScrollViewer Padding="16,8,16,24">
        <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="PDF to Images" FontSize="22" FontWeight="Bold" />
                <TextBlock
                    Text="Convert PDF pages into crisp, high-resolution PNG or JPG image files."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Drop Zone -->
            <Border
                x:Name="DropZone"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xEB9D;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Drag and drop a PDF file here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="or click below to choose a file" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <Button
                        Content="Browse PDF File..."
                        Command="{x:Bind ViewModel.PickFileCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        AutomationProperties.Name="Browse PDF File to Convert to Images" />
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsClosable="True" />

            <!-- Selected File Card -->
            <Border
                Visibility="{x:Bind ViewModel.FileVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A5;" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SelectedFile.FileName, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedFile.DetailText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SelectedFile.FormattedSize, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        Grid.Column="3"
                        Content="Remove"
                        Command="{x:Bind ViewModel.ClearFileCommand}"
                        AutomationProperties.Name="Remove Selected File" />
                </Grid>
            </Border>

            <!-- Export Options -->
            <Border
                Visibility="{x:Bind ViewModel.FileVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Image Export Options" FontWeight="SemiBold" FontSize="15" />

                    <!-- Format -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Output Image Format" FontSize="13" FontWeight="Medium" />
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}" MaxColumns="2">
                            <RadioButton Content="PNG (Lossless, Transparent, Best for Text &amp; Graphics)" />
                            <RadioButton Content="JPG (Compressed, Best for Scanned Photos)" />
                        </RadioButtons>
                    </StackPanel>

                    <!-- DPI Resolution -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Resolution (DPI)" FontSize="13" FontWeight="Medium" />
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.DpiIndex, Mode=TwoWay}" MaxColumns="4">
                            <RadioButton Content="96 DPI (Web / Fast)" />
                            <RadioButton Content="150 DPI (Balanced Standard)" />
                            <RadioButton Content="200 DPI (High Quality)" />
                            <RadioButton Content="300 DPI (Print Quality)" />
                        </RadioButtons>
                    </StackPanel>

                    <!-- Page Scope -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Pages to Export" FontSize="13" FontWeight="Medium" />
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.PageScopeIndex, Mode=TwoWay}">
                            <RadioButton Content="All pages in document" />
                            <RadioButton Content="Custom page range only" />
                        </RadioButtons>
                    </StackPanel>

                    <!-- Custom Range -->
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.CustomRangeVisibility, Mode=OneWay}">
                        <TextBlock Text="Page Range" FontSize="13" FontWeight="Medium" />
                        <TextBox
                            Text="{x:Bind ViewModel.CustomRangeExpression, Mode=TwoWay}"
                            PlaceholderText="e.g. 1-3, 5, 8-10"
                            AutomationProperties.Name="Page Range Input for Export" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Panel -->
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.FileVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Content="Export PDF to Images"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ExecuteConvertCommand}"
                    IsEnabled="{x:Bind ViewModel.CanConvert, Mode=OneWay}"
                    Padding="28,10,28,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="Export PDF to Images Primary Action" />
                <Button
                    Grid.Column="1"
                    Content="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Padding="16,10,16,10"
                    AutomationProperties.Name="Cancel Export Button" />
            </Grid>

            <!-- Progress Panel -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}">
                <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Result Card -->
            <Border
                Visibility="{x:Bind ViewModel.ResultVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemAccentColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Images Exported Successfully!" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ExportSummaryText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button
                            Content="Open Output Folder"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenResultFolderCommand}"
                            AutomationProperties.Name="Open Output Folder Button" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
