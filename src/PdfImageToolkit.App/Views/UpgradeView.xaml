<Page
    x:Class="PdfImageToolkit.Views.UpgradeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:PdfImageToolkit.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Upgrade to Pro"
                    FontSize="28"
                    FontWeight="Bold"
                    AutomationProperties.Name="Upgrade Page Title" />
                <TextBlock
                    Text="Unlock unlimited offline PDF and image processing with a one-time purchase."
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Current Status Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Current License Status" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LicenseStatusText, Mode=OneWay}"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Visibility="{x:Bind ViewModel.FreeQuotaVisibility, Mode=OneWay}"
                            Text="{x:Bind ViewModel.RemainingTodayFormatted, Mode=OneWay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Margin="0,4,0,0" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Content="{x:Bind ViewModel.PurchaseButtonText, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.PurchaseProCommand}"
                        IsEnabled="{x:Bind ViewModel.CanPurchase, Mode=OneWay}"
                        Padding="20,10,20,10"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Unlock Pro Button" />
                </Grid>
            </Border>

            <!-- Status / Error Notification -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                IsClosable="True" />

            <!-- Comparison Table -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Feature Comparison" FontWeight="SemiBold" FontSize="16" />
                    <Grid RowSpacing="12" ColumnSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Header -->
                        <TextBlock Text="Capability" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Free Tier" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Pro Edition" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                        <!-- Row 1: Operations per Day -->
                        <TextBlock Grid.Row="1" Text="Operations per day" FontSize="13" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="5 per day" FontSize="13" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Unlimited" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" />

                        <!-- Row 2: Files per Batch -->
                        <TextBlock Grid.Row="2" Text="Files per batch" FontSize="13" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Max 10 files" FontSize="13" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Unlimited" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" />

                        <!-- Row 3: Max File Size -->
                        <TextBlock Grid.Row="3" Text="Max file size" FontSize="13" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="50 MB per file" FontSize="13" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Unlimited" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" />

                        <!-- Row 4: Privacy & Offline -->
                        <TextBlock Grid.Row="4" Text="Offline local execution" FontSize="13" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="✓ 100% Offline" FontSize="13" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="✓ 100% Offline" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
